# Copie para .env e preencha com os valores do seu projeto.
# Variáveis VITE_ são embutidas no app do navegador: nunca coloque chaves secretas aqui.

VITE_SUPABASE_URL=https://<id-do-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<chave-anon-publica>
VITE_N8N_WEBHOOK_URL=https://<seu-n8n>/webhook/<id>
